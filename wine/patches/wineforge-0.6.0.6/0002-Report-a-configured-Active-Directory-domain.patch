     struct addrinfo hints = {0}, *res;
-    char *dot, buffer[256], *name = buffer;
+    char *dot, buffer[256], *name = buffer, *override;
     HKEY key, subkey;
 
     if (gethostname( buffer, sizeof(buffer) )) return;
@@ -840,6 +840,9 @@ static void create_computer_name_keys(void)
     dot = strchr( name, '.' );
     if (dot) *dot++ = 0;
     else dot = name + strlen(name);
+    /* Vinter: a configured computer name and Active Directory domain win over the host's */
+    if ((override = getenv( "WINECOMPUTERNAME" )) && *override) name = override;
+    if ((override = getenv( "WINEDNSDOMAIN" )) && *override) dot = override;
     SetComputerNameExA( ComputerNamePhysicalDnsDomain, dot );
     SetComputerNameExA( ComputerNamePhysicalDnsHostname, name );
     if (res) freeaddrinfo( res );
@@ -867,6 +870,7 @@ static void create_volatile_environment_registry_key(void)
 {
     WCHAR path[MAX_PATH];
     WCHAR computername[MAX_COMPUTERNAME_LENGTH + 1 + 2];
+    const WCHAR *domain;
     DWORD size;
     HKEY hkey;
     HRESULT hr;
@@ -908,6 +912,17 @@ static void create_volatile_environment_registry_key(void)
         set_reg_value( hkey, L"LOGONSERVER", computername );
     }
 
+    /* Vinter: the user's configured Active Directory domain */
+    if ((domain = _wgetenv( L"WINEDOMAIN" )) && *domain)
+        set_reg_value( hkey, L"USERDOMAIN", domain );
+    if ((domain = _wgetenv( L"WINEDNSDOMAIN" )) && *domain)
+    {
+        WCHAR dns_domain[256];
+
+        lstrcpynW( dns_domain, domain, ARRAY_SIZE(dns_domain) );
+        set_reg_value( hkey, L"USERDNSDOMAIN", wcsupr( dns_domain ) );
+    }
+
     set_reg_value( hkey, L"SESSIONNAME", L"Console" );
     RegCloseKey( hkey );
 }
