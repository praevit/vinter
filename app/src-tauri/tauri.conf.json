{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vinter",
  "identifier": "com.praevit.vinter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vinter",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "category": "Utility",
    "homepage": "https://getvinter.app",
    "publisher": "Vinter",
    "shortDescription": "Windows apps, poured onto your Mac.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "copyright": "\u00a9 2026 Pr\u00e6vit ehf.",
    "longDescription": "Vinter runs Windows programs on macOS and Linux using Wine: it manages Wine runtimes, bottles, app recipes and native launchers.",
    "license": "GPL-3.0-or-later",
    "fileAssociations": [
      {
        "ext": [
          "exe"
        ],
        "name": "Windows program",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/x-msdownload"
      },
      {
        "ext": [
          "msi"
        ],
        "name": "Windows installer",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/x-msi"
      },
      {
        "ext": [
          "vinterbottle"
        ],
        "name": "Vinter bottle backup",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-vinterbottle"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "vinter"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://getvinter.app/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNkFCREJEMEU3M0Y0MkIKUldRcjlITU92YjFxUE1wWmxLZ0tneUZ2U3lrNTVKUU1vV09mSjA4MHRzNWtFMkNWbnFjQ1FvaEcK"
    }
  }
}
