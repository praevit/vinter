{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "updates",
  "description": "Permissions for the small Software Update window: check for and install updates, move and close itself.",
  "windows": [
    "updates"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-app-info",
    "allow-update-check",
    "allow-update-install"
  ]
}
