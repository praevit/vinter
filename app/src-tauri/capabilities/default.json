{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window. Only Vinter's own commands and job/run events; no shell or fs access. Links, the installer file dialog, deep links and updates are handled in Rust, so the opener, dialog, deep-link and updater plugins grant nothing to the frontend.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-system-checks",
    "allow-rosetta-install",
    "allow-runtimes-available",
    "allow-runtimes-installed",
    "allow-runtime-install",
    "allow-runtime-remove",
    "allow-runtime-updates",
    "allow-runtime-update",
    "allow-runtime-open-link",
    "allow-bottles-list",
    "allow-bottle-get",
    "allow-bottle-create",
    "allow-bottle-update",
    "allow-bottle-set-windows-version",
    "allow-bottle-set-options",
    "allow-bottle-domain-status",
    "allow-bottle-set-domain",
    "allow-bottle-domain-sign-in",
    "allow-bottle-duplicate",
    "allow-bottle-export",
    "allow-bottle-import",
    "allow-bottle-delete",
    "allow-bottle-open-drive-c",
    "allow-bottle-tool",
    "allow-bottle-kill-all",
    "allow-installer-choose",
    "allow-installer-run",
    "allow-programs-discover",
    "allow-programs-add",
    "allow-program-remove",
    "allow-program-update",
    "allow-program-choose-icon",
    "allow-programs-list",
    "allow-program-launch",
    "allow-program-stop",
    "allow-runs-list",
    "allow-logs-list",
    "allow-log-read",
    "allow-graphics-backends",
    "allow-bottle-set-graphics",
    "allow-bottle-test-graphics",
    "allow-recipes-list",
    "allow-recipe-apply",
    "allow-recipe-state",
    "allow-recipe-resume",
    "allow-recipes-open-folder",
    "allow-app-info",
    "allow-app-open-link",
    "allow-debug-report",
    "allow-update-check",
    "allow-update-install",
    "allow-program-set-pinned",
    "allow-open-files-take",
    "allow-settings-get",
    "allow-settings-set",
    "allow-settings-set-launch-at-login",
    "allow-storage-usage",
    "allow-storage-clear-downloads",
    "allow-bottle-disk-usage",
    "allow-bottle-clean",
    "allow-d3dmetal-status",
    "allow-d3dmetal-choose",
    "allow-d3dmetal-import",
    "allow-d3dmetal-remove"
  ]
}
