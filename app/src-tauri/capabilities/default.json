{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window. Only Vinter's own commands and job/run events; no shell or fs access. Links and the installer file dialog are opened from Rust, so the opener and dialog plugins grant nothing to the frontend.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-system-checks",
    "allow-rosetta-install",
    "allow-runtimes-available",
    "allow-runtimes-installed",
    "allow-runtime-install",
    "allow-runtime-remove",
    "allow-runtime-open-link",
    "allow-bottles-list",
    "allow-bottle-get",
    "allow-bottle-create",
    "allow-bottle-update",
    "allow-bottle-set-windows-version",
    "allow-bottle-duplicate",
    "allow-bottle-delete",
    "allow-bottle-open-drive-c",
    "allow-bottle-tool",
    "allow-bottle-kill-all",
    "allow-installer-choose",
    "allow-installer-run",
    "allow-programs-discover",
    "allow-programs-add",
    "allow-program-remove",
    "allow-programs-list",
    "allow-program-launch",
    "allow-program-stop",
    "allow-runs-list",
    "allow-logs-list",
    "allow-log-read"
  ]
}
