    "allow-update-status",
    "allow-update-install",
    "allow-program-set-pinned",
    "allow-open-files-take",
    "allow-approvals-pending",
    "allow-approval-decide",
    "allow-settings-get",
    "allow-settings-set",
    "allow-settings-set-launch-at-login",
    "allow-settings-window-show",
    "allow-storage-usage",
