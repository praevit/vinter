{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main and Settings windows. Only Vinter's own commands, job/run events and right-click menus; no shell or fs access. Links, the installer file dialog, deep links and updates are handled in Rust, so the opener, dialog, deep-link and updater plugins grant nothing to the frontend.",
  "windows": [
    "main",
    "settings"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:menu:allow-new",
    "core:menu:allow-popup",
    "core:resources:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-system-checks",
    "allow-rosetta-install",
    "allow-runtimes-available",
    "allow-runtimes-installed",
    "allow-runtime-install",
    "allow-runtime-remove",
    "allow-runtime-updates",
    "allow-runtime-update",
    "allow-runtime-open-link",
    "allow-bottles-list",
    "allow-bottle-get",
    "allow-bottle-create",
    "allow-bottle-update",
    "allow-bottle-set-windows-version",
    "allow-bottle-set-options",
    "allow-bottle-domain-status",
    "allow-bottle-set-domain",
    "allow-bottle-domain-sign-in",
    "allow-bottle-duplicate",
    "allow-bottle-export",
    "allow-bottle-import",
    "allow-bottle-delete",
    "allow-bottle-open-drive-c",
    "allow-bottle-tool",
    "allow-bottle-kill-all",
    "allow-bottle-set-drives",
    "allow-drive-choose-folder",
    "allow-components-list",
    "allow-components-install",
    "allow-snapshots-list",
    "allow-snapshot-create",
    "allow-snapshot-restore",
    "allow-snapshot-delete",
    "allow-installer-choose",
    "allow-installer-run",
    "allow-programs-discover",
    "allow-programs-add",
    "allow-program-remove",
    "allow-program-update",
    "allow-program-choose-icon",
    "allow-programs-list",
    "allow-program-launch",
    "allow-program-launch-logged",
    "allow-program-open-files",
    "allow-program-set-file-types",
    "allow-program-stop",
    "allow-program-show",
    "allow-runs-list",
    "allow-logs-list",
